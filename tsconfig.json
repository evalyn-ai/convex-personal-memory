{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "target": "ESNext",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "types": ["bun", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "bench/**/*.ts"],
  "exclude": ["node_modules"]
}
